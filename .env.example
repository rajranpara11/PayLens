# Copy to .env and replace placeholders. Do not commit .env.

# --- PostgreSQL ---
POSTGRES_DB=paylens
POSTGRES_USER=paylens
POSTGRES_PASSWORD=change-me-db-password

# --- HR Manager login (set password OR bcrypt hash; prefer hash in real deploys) ---
PAYLENS_HR_USERNAME=hr.manager
PAYLENS_HR_PASSWORD=change-me-hr-password
# PAYLENS_HR_PASSWORD_HASH=

# Browser origin served by the frontend container (nginx on FRONTEND_PORT).
PAYLENS_CORS_ORIGINS=http://localhost:8088
FRONTEND_PORT=8088

# Secure session cookie (prod profile defaults to true). Must be false for local HTTP Compose.
PAYLENS_SESSION_COOKIE_SECURE=false

# Optional: seed 10k employees on first empty DB (slow; assessment demo).
PAYLENS_SEED_ENABLED=false
PAYLENS_SEED_EMPLOYEE_COUNT=10000
PAYLENS_SEED_RANDOM_SEED=42
PAYLENS_SEED_BATCH_SIZE=500
